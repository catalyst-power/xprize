# =============================================================================
# AgriFortress — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# --- Kernel ---
# Base URL of the Imajin kernel instance this app connects to.
# Phase 1: existing Imajin instance. Leave as-is for production.
KERNEL_URL=https://imajin.ai

# --- App identity (from app registration) ---
# The app's registered DID (did:imajin:...). Obtained after registering
# AgriFortress with the Imajin kernel (issue #3 in the epic).
APP_DID=

# Ed25519 private key seed as hex (32 bytes = 64 hex chars).
# Generated at registration time. Keep secret — never commit.
APP_PRIVATE_KEY=

# The user's consent attestation ID (from the app-auth consent flow).
# Ties the app's DID to a specific user's supply:read/write grant.
APP_ATTESTATION_ID=

# The app's own org-level consent attestation ID (distinct from the
# per-supplier APP_ATTESTATION_ID above). Used only to check org-subsidized
# connector status (e.g. Gemini) on the Connected Services panel — see
# docs/kernel-api-context.md (#1540). Optional: leave unset if AgriFortress
# has no org-level connectors configured yet; the panel shows "status
# unavailable" for those rather than a false positive/negative.
APP_ORG_ATTESTATION_ID=

# Registry app ID — the internal app_xxx identifier returned at registration.
# Used to build the consent URL: {KERNEL_URL}/auth/authorize?app_id={APP_ID}&...
# Distinct from APP_DID (which is used for token minting via the keypair).
#
# IMPORTANT: the callbackUrl is baked into the registration and cannot change
# at runtime. Use a SEPARATE registration (= different APP_ID) for each
# deployment target:
#   dev:  callbackUrl = https://dev-integrity.imajin.ai/api/auth/callback
#   prod: callbackUrl = https://integrity.imajin.ai/api/auth/callback
APP_ID=

# --- User sessions ---
# Secret used to sign the httpOnly session cookie (HS256 JWT, 7-day TTL).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL of this app (used for auth callback redirects behind a proxy).
# Prod: https://integrity.imajin.ai
# Falls back to the incoming request origin if not set (fine for local dev).
NEXT_PUBLIC_APP_URL=

# --- Port convention (client apps: dev 3400+ / prod 7400+) ---
# Dev: 3403 (set in package.json dev script)
# Prod: PORT=7403 (Next.js standalone server honours PORT env var)
PORT=7403
