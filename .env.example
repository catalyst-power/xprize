# =============================================================================
# AgriFortress — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# --- Kernel ---
# Base URL of the Imajin kernel instance this app connects to.
# Phase 1: existing Imajin instance. Leave as-is for production.
KERNEL_URL=https://imajin.ai

# --- App identity (from app registration) ---
# The app's registered DID (did:imajin:...). Obtained after registering
# AgriFortress with the Imajin kernel (issue #3 in the epic).
APP_DID=

# Ed25519 private key seed as hex (32 bytes = 64 hex chars).
# Generated at registration time. Keep secret — never commit.
APP_PRIVATE_KEY=

# DEPRECATED for per-user kernel calls (xprize#36) — this app is multi-user,
# so there is no single "the" supplier attestation to bake in here. Every
# real request now resolves the acting user's own attestation from their
# session cookie (see src/lib/session.ts SessionUser.attestationId) and
# passes it explicitly to fetchKernel(). Also no longer used by the Stripe
# settlement webhook (xprize#68 retired that stopgap in favour of the app's
# own session-less service credential — see fetchKernelAsSelf/
# getLotChainAsSelf). This var is only read by:
#   - GET /api/health/kernel — a connectivity smoke test, not a user request
#   - src/__e2e__/*.test.ts   — a fixed test-fixture identity for CI
# Leave unset unless you're running one of those.
APP_ATTESTATION_ID=

# Registry app ID — the internal app_xxx identifier returned at registration.
# Used to build the consent URL: {KERNEL_URL}/auth/authorize?app_id={APP_ID}&...
# Distinct from APP_DID (which is used for token minting via the keypair).
#
# IMPORTANT: the callbackUrl is baked into the registration and cannot change
# at runtime. Use a SEPARATE registration (= different APP_ID) for each
# deployment target:
#   dev:  callbackUrl = https://dev-integrity.imajin.ai/api/auth/callback
#   prod: callbackUrl = https://integrity.imajin.ai/api/auth/callback
APP_ID=

# --- User sessions ---
# Secret used to sign the httpOnly session cookie (HS256 JWT, 7-day TTL).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL of this app (used for auth callback redirects behind a proxy).
# Prod: https://integrity.imajin.ai
# Falls back to the incoming request origin if not set (fine for local dev).
NEXT_PUBLIC_APP_URL=

# --- Port convention (client apps: dev 3400+ / prod 7400+) ---
# Dev: 3403 (set in package.json dev script)
# Prod: PORT=7403 (Next.js standalone server honours PORT env var)
PORT=7403

# --- Settlement, stage 5 (xprize#60) ---
# Service-to-service API key for POST /pay/api/settle. This is NOT app-auth
# (no Bearer token minted via APP_DID/APP_PRIVATE_KEY) — the kernel's settle
# route checks this key directly against its own PAY_SERVICE_API_KEY. Ask
# the kernel operator for this value; never invent or share it in code.
PAY_SERVICE_API_KEY=

# QuickBooks Item (catalog line item) used for every settlement invoice line
# created via POST /quickbooks/api/invoice. The kernel has no product ->
# QBO-item resolver yet (documented follow-up on xprize#60), so every line
# is billed against this single configured Item until that lands.
QUICKBOOKS_DEFAULT_ITEM_REF=

# QuickBooks Customer this app bills settlement invoices to, until the
# kernel can resolve a buyer DID to a QBO Customer (documented follow-up on
# xprize#60). Demo-only stand-in — do not treat as a real buyer directory.
QUICKBOOKS_DEFAULT_CUSTOMER_REF=

# Signing secret for AgriFortress's OWN Stripe webhook endpoint
# (POST /api/webhooks/stripe), issued by Stripe when that URL is registered
# as an additional webhook endpoint on the platform's Stripe account. This is
# separate from the kernel's own STRIPE_WEBHOOK_SECRET (which verifies
# deliveries to the kernel's /pay/api/webhook, not this app's route).
STRIPE_WEBHOOK_SECRET=

# Platform/org DID credited as `from_did` when this app settles a
# Stripe-paid invoice directly via POST /pay/api/settle (the payer side of
# the .fair manifest). Ask the kernel operator for this value.
PLATFORM_DID=

# --- Delivery resend + reminder ladder (xprize#75) ---
# Comma-separated minutes-since-signing for the automatic reminder ladder
# nudging an unsigned delivery's recipient (POST /api/delivery/reminders/check).
# Leave unset for the default 5m,1h,24h,7d ladder ("5,60,1440,10080").
REMINDER_LADDER_MINUTES=

# Optional shared secret enabling an external cron/scheduler to drive the
# reminder ladder via `Authorization: Bearer <this value>` on
# POST /api/delivery/reminders/check, instead of relying solely on the
# dashboard-load trigger. Leave unset to disable this path entirely (the
# dashboard-load trigger still works either way) — see that route's header
# comment for why the caller must also supply each supplier's own session
# attestation (this app has no service credential that can send a chat
# message on a supplier's behalf).
REMINDER_CRON_SECRET=
