# Imajin kernel auth service (public API)
# Dev: https://dev-jin.imajin.ai/auth
# Prod: https://jin.imajin.ai/auth
AUTH_SERVICE_URL=https://dev-jin.imajin.ai/auth

# Public base URL of this app (used for callbacks, links)
NEXT_PUBLIC_BASE_URL=http://localhost:3402

# This app's DID (obtained after registration with Imajin — issue #3)
APP_DID=did:imajin:YOUR_APP_DID_HERE

# Runtime
PORT=3402
NODE_ENV=development
