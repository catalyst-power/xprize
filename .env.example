# --- Imajin kernel (the public app surface this app composes) ---
# prod: https://jin.imajin.ai   dev: https://dev-jin.imajin.ai
KERNEL_URL=https://dev-jin.imajin.ai
AUTH_SERVICE_URL=https://dev-jin.imajin.ai/auth

# --- This app's registration credentials (from app registration) ---
APP_DID=did:imajin:REPLACE_ME
APP_PRIVATE_KEY=REPLACE_ME          # this app's signing key — NEVER commit the real value

# --- Session (jose HS256 cookie, scorecard pattern) ---
SESSION_SECRET=REPLACE_ME           # 32+ random bytes

# --- App ---
PORT=3000
NODE_ENV=development
